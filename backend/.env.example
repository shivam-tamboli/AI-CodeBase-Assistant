# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000

# ── Embedding Provider ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── API Keys ──────────────────────────────────────────────────────────────────
# Required — get at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when LLM_PROVIDER=anthropic — get at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — enables Cohere re-ranking. Free tier: 1000 req/month
# Get at https://cohere.com
COHERE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Replace <username>, <password>, <cluster>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.<cluster>.mongodb.net/ragdb?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Include all Vite dev ports to avoid CORS errors
# when Vite falls back to 5174/5175 if 5173 is busy.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── GitHub ────────────────────────────────────────────────────────────────────
# No server-side token. Public repos clone anonymously; for a private repo the
# user pastes their own token in the import panel (sent per request, never stored).

# ── Indexing ──────────────────────────────────────────────────────────────────
# Set true to generate LLM summaries per chunk at index time (slower, costs more)
ENABLE_CHUNK_SUMMARIES=false

# ── Upload limits ─────────────────────────────────────────────────────────────
# Max ZIP size, and max total size it may expand to when extracted
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=200

# ── Demo ──────────────────────────────────────────────────────────────────────
# Public repo indexed once at startup as a shared, read-only demo ("Try a demo
# repo" button). Leave empty to disable.
DEMO_REPO_URL=https://github.com/pallets/itsdangerous
